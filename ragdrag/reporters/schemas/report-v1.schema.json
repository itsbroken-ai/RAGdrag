{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/McKern3l/RAGdrag/schemas/report-v1.schema.json",
  "title": "RAGdrag Report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "run", "target", "safety", "summary", "capabilities", "findings", "evidence", "mutations", "sensitive_artifacts", "implementation_status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tool": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "ragdrag"}, "version": {"type": "string"}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["run_id", "started_at", "ended_at", "status", "exit_code"], "properties": {"run_id": {"type": "string"}, "started_at": {"type": "string"}, "ended_at": {"type": "string"}, "status": {"enum": ["completed", "partial", "failed", "interrupted"]}, "exit_code": {"type": "integer", "minimum": 0, "maximum": 5}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["url", "approved_origins", "query_field", "response_field"], "properties": {"url": {"type": "string"}, "approved_origins": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "query_field": {"type": "string"}, "response_field": {"type": ["string", "null"]}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["impact_ceiling", "write_enabled"], "properties": {"impact_ceiling": {"enum": ["passive", "active-non-mutating", "mutating"]}, "write_enabled": {"type": "boolean"}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["total_capabilities", "completed", "partial", "skipped", "blocked", "failed", "total_findings", "observed", "inferred", "validated", "unresolved_mutations"], "properties": {"total_capabilities": {"type": "integer", "minimum": 0}, "completed": {"type": "integer", "minimum": 0}, "partial": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}, "blocked": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "total_findings": {"type": "integer", "minimum": 0}, "observed": {"type": "integer", "minimum": 0}, "inferred": {"type": "integer", "minimum": 0}, "validated": {"type": "integer", "minimum": 0}, "unresolved_mutations": {"type": "integer", "minimum": 0}}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "mutations": {"type": "array", "items": {"$ref": "#/$defs/mutation"}},
    "sensitive_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "implementation_status": {"type": "array", "items": {"$ref": "#/$defs/implementation"}}
  },
  "$defs": {
    "capability": {"type": "object", "additionalProperties": false, "required": ["capability_id", "technique_ids", "status", "impact", "started_at", "ended_at", "trials", "controls", "finding_ids", "evidence_ids", "outcomes", "errors", "mutation_ids", "cleanup_state", "summary", "payload"], "properties": {"capability_id": {"type": "string"}, "technique_ids": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["completed", "partial", "skipped", "blocked", "failed"]}, "impact": {"enum": ["passive", "active-non-mutating", "mutating"]}, "started_at": {"type": "string"}, "ended_at": {"type": "string"}, "trials": {"type": "integer", "minimum": 0}, "controls": {"type": "array", "items": {"type": "string"}}, "finding_ids": {"type": "array", "items": {"type": "string"}}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "outcomes": {"type": "array", "items": {"enum": ["unreachable", "authentication-required", "unsupported-response", "invalid-target", "rate-limited", "blocked-by-control", "capability-not-applicable", "indeterminate"]}}, "errors": {"type": "array", "items": {"type": "string"}}, "mutation_ids": {"type": "array", "items": {"type": "string"}}, "cleanup_state": {"enum": ["not-created", "active", "removed", "restored", "unresolved", "unknown"]}, "summary": {"type": "string"}, "payload": {"type": "object"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "technique_id", "technique_name", "severity", "confidence", "evidence_state", "confidence_basis", "detail", "affected_component", "evidence", "remediation"], "properties": {"finding_id": {"type": "string"}, "technique_id": {"type": "string"}, "technique_name": {"type": "string"}, "severity": {"enum": ["critical", "high", "medium", "low", "info"]}, "confidence": {"enum": ["high", "medium", "low"]}, "evidence_state": {"enum": ["observed", "inferred", "validated"]}, "confidence_basis": {"type": "string"}, "detail": {"type": "string"}, "affected_component": {"type": "string"}, "evidence": {"type": "object"}, "remediation": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "capability_id", "trial_id", "timestamp", "state", "confidence_basis", "request_summary", "response_summary", "artifact_digest"], "properties": {"evidence_id": {"type": "string"}, "capability_id": {"type": "string"}, "trial_id": {"type": "string"}, "timestamp": {"type": "string"}, "state": {"enum": ["observed", "inferred", "validated"]}, "confidence_basis": {"type": "string"}, "request_summary": {"type": "object"}, "response_summary": {"type": "object"}, "artifact_digest": {"type": ["string", "null"]}}},
    "mutation": {"type": "object", "additionalProperties": false, "required": ["mutation_id", "capability_id", "target_scope", "operation", "object_id", "cleanup_method", "state", "cleanup_attempts", "evidence_ids"], "properties": {"mutation_id": {"type": "string"}, "capability_id": {"type": "string"}, "target_scope": {"type": "string"}, "operation": {"type": "string"}, "object_id": {"type": "string"}, "cleanup_method": {"type": "string"}, "state": {"enum": ["not-created", "active", "removed", "restored", "unresolved", "unknown"]}, "cleanup_attempts": {"type": "integer", "minimum": 0}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["phase", "capability", "technique_ids", "impact", "maturity", "status", "release"], "properties": {"phase": {"type": "string"}, "capability": {"type": "string"}, "technique_ids": {"type": "array", "items": {"type": "string"}}, "impact": {"enum": ["passive", "active-non-mutating", "mutating"]}, "maturity": {"type": "string"}, "status": {"enum": ["catalogued", "implemented", "validated", "experimental"]}, "release": {"type": "string"}}}
  }
}
